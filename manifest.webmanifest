{
  "name": "Feeding Log",
  "short_name": "Feeding",
  "description": "Private, offline breastfeeding, bottle, pump, diaper and sleep tracker.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1c1a24",
